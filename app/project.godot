; Engine configuration file.

config_version=5

[application]

config/name="Dogeometric"
config/version="0.4.1"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.96, 0.96, 0.96, 1)
boot_splash/image="res://splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[audio]

driver/driver="Dummy"

[display]

window/size/viewport_width=1600
window/size/viewport_height=960

[dotnet]

project/assembly_name="Dogeometric"
project/solution_directory=".."

[rendering]

textures/vram_compression/import_etc2_astc=true

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/16_bits=false

[shader_globals]

section_plane={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
